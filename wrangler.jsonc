{
  // App operativa Fenice Film su Cloudflare Workers.
  // Segreti da impostare nel pannello (Settings → Variables and Secrets): PASSWORD_TITOLARI, PASSWORD_COLLABORATORI, GCAL_ICS_URL
  "name": "fenice-film-app",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ARCHIVIO", "class_name": "Archivio" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Archivio"] }],
  "observability": { "enabled": true }
}
